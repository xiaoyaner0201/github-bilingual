{
  "manifest_version": 3,
  "name": "GitHub Bilingual",
  "description": "Bilingual GitHub issues and PRs: see the version in your language first.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
